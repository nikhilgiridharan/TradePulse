# Polygon.io API credentials
# Get your key at https://polygon.io/dashboard
POLYGON_API_KEY=your_polygon_api_key_here

# Kafka configuration
# For local Docker: localhost:9092
# For Confluent Cloud: pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# Kafka topic names
KAFKA_TOPIC_TRADES=market.trades
KAFKA_TOPIC_DLQ=market.trades.dlq
KAFKA_TOPIC_AGGREGATIONS=market.aggregations
KAFKA_TOPIC_ANOMALIES=market.anomalies

# AWS configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# DynamoDB table names
DYNAMO_TABLE_TRADES=market_trades
DYNAMO_TABLE_AGGREGATIONS=market_aggregations
DYNAMO_TABLE_ANOMALIES=market_anomalies
DYNAMO_TABLE_FEATURES=feature_store

# S3 configuration
S3_BUCKET_NAME=marketflow-data
S3_PREFIX_TRADES=trades
S3_PREFIX_ANOMALIES=anomalies
S3_PREFIX_DEAD_LETTERS=dead-letters

# SQS configuration
SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/marketflow-dlq
SQS_VALIDATION_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/marketflow-validation-dlq

# FastAPI configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RATE_LIMIT=100

# Tickers to subscribe to
TICKERS=AAPL,GOOGL,MSFT,AMZN,TSLA

# CloudWatch configuration
CLOUDWATCH_NAMESPACE=MarketFlow/Production
CLOUDWATCH_ENABLED=true

# Pipeline tuning
BACKPRESSURE_LATENCY_THRESHOLD_MS=100
BACKPRESSURE_PAUSE_MS=500
DLQ_MAX_RETRIES=3
DLQ_RETRY_INTERVAL_MINUTES=15
S3_BUFFER_FLUSH_INTERVAL_SECONDS=300
S3_BUFFER_MAX_MB=10
ANOMALY_CONTAMINATION=0.01
ANOMALY_TRAINING_WINDOW=1000
ANOMALY_RETRAIN_INTERVAL=500
